# Copy this file and fill in the values for the instance you want to test.
#
#   .env              -> used when TEST_ENV is not set (npm test)
#   .env.staging      -> TEST_ENV=staging      (npm run test:staging)
#   .env.production   -> TEST_ENV=production   (npm run test:prod)
#   .env.development  -> TEST_ENV=development  (npm run test:dev)
#   .env.jamf         -> TEST_ENV=jamf         (npm run test:jamf)
#
# Real env files are gitignored. Never commit credentials.

# Instance URL is built as https://<NAMESPACE>.<REGION>.<DOMAIN>
NAMESPACE=
REGION=
DOMAIN=

# Admin account used by globalSetup to log in
EMAIL=
PASSWORD=

# Optional: localStorage key/value set before the app loads.
# Needed for instances that hang on the loading screen (e.g. team-a).
# Leave empty if the instance loads normally.
LSCACHE_KEY=
LSCACHE_VALUE=
